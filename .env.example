# Copy to .env (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# All private data (exports, seed, eval set, DB, traces) lives OUTSIDE the repo.
EXPENSE_DATA_DIR=C:\expense-data

# Budget (USD). Hard cap is also set at the Anthropic console.
BUDGET_HARD_USD=3
BUDGET_SOFT_USD=2

# Local SQLite file (inside EXPENSE_DATA_DIR) or a Turso URL in production.
DATABASE_URL=file:C:\expense-data\expense.db
