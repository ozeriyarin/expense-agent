{
  "name": "expense-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal household expense assistant: CSV + chat in, categorized SQLite + Excel out, Telegram reports.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard-staged.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "import": "tsx --env-file-if-exists=.env src/cli/import.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@google/genai": "^3.0.0",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "exceljs": "^4.4.0",
    "p-limit": "^7.3.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  }
}
